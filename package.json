    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/register": "^7.23.7",
    "@types/node": "^18.0.6",
    "babel-cli": "^6.26.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.16.4",
    "moment": "^2.30.1",
    "mongoose": "^5.11.15",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.2.6"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
